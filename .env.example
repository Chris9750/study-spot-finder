# Copy to .env.local and fill in.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/studyspots

# Google Maps JavaScript API key (enable "Maps JavaScript API" in Google Cloud).
# Restrict it to your domains (HTTP referrers) since it is exposed to the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from Google Cloud enables Advanced Markers styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Where the map opens (defaults to Queen's University, Kingston).
NEXT_PUBLIC_CAMPUS_LAT=44.2253
NEXT_PUBLIC_CAMPUS_LNG=-76.4951
