# Copy to .env.local and fill in.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/studyspots

# ---------- Google Maps ----------
# Enable "Maps JavaScript API" in Google Cloud and restrict the key to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# A Map ID from Google Cloud enables Advanced Markers styling.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Where the map opens and which time zone "open now" / busy-by-hour use.
NEXT_PUBLIC_CAMPUS_LAT=44.2253
NEXT_PUBLIC_CAMPUS_LNG=-76.4951
NEXT_PUBLIC_CAMPUS_TZ=America/Toronto

# ---------- Sign-in (Auth.js) ----------
# Required. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Only these email domains can sign in (comma-separated). Leave empty to allow anyone.
ALLOWED_EMAIL_DOMAINS=queensu.ca

# Google sign-in: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft sign-in (school Microsoft 365 accounts): Azure portal > App registrations
# Redirect URI: http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id>/v2.0  (or .../common/v2.0 for any account)
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Local testing without Google/Microsoft: shows an email-only sign-in form.
# Ignored in production builds.
AUTH_DEV_LOGIN=true

# When deployed behind a proxy (e.g. not on Vercel), set this:
# AUTH_TRUST_HOST=true

# ---------- Moderation ----------
# These accounts can open /admin to review reported photos and comments.
ADMIN_EMAILS=
# Number of different students whose reports auto-hide an item.
REPORT_HIDE_THRESHOLD=3
